{
  "$schema": "https://schema.openspace.host/v1/styles.json",
  "choices": {
    "palette": {
      "brand": "#a7c25a",
      "neutral": "warm",
      "contrast": "standard",
      "source": "brand"
    },
    "pairing": "dm-serif-dm-sans",
    "density": "comfortable",
    "shape": "round",
    "buttons": "pill-gradient",
    "motion": "none",
    "imageTreatment": "rounded",
    "appearance": "auto",
    "typography": {
      "heading": {
        "family": "Fraunces",
        "category": "serif",
        "italic": true
      },
      "body": {
        "family": "Fraunces",
        "category": "serif",
        "italic": true
      },
      "scale": {
        "h1": {
          "size": 61
        }
      }
    },
    "layout": {
      "sectionPadding": 96
    }
  },
  "overrides": {
    "color": {
      "background": {
        "$value": "#fbf7f0",
        "$type": "color"
      },
      "text": {
        "$value": "#1d2b2b",
        "$type": "color"
      },
      "accent": {
        "$value": "#1f7a7a",
        "$type": "color"
      },
      "dark": {
        "background": {
          "$value": "#1d2b2b",
          "$type": "color"
        },
        "text": {
          "$value": "#fbf7f0",
          "$type": "color"
        },
        "heading": {
          "$value": "#fbf7f0",
          "$type": "color"
        }
      },
      "light": {
        "background": {
          "$value": "#e9e6d2",
          "$type": "color"
        }
      }
    }
  }
}
